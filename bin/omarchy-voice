#!/usr/bin/env bash
set -euo pipefail

# omarchy-voice: CLI and IPC controller for omarchy-voice assistant
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
action="${1:-toggle}"

case "$action" in
  toggle|pill)
    exec omarchy-shell voice togglePill
    ;;
  expand|drawer|expanded)
    exec omarchy-shell voice toggleExpanded
    ;;
  mute)
    exec omarchy-shell voice toggleMute
    ;;
  dismiss|close)
    exec omarchy-shell voice dismiss
    ;;
  agent|workspace)
    exec omarchy-shell voice toggleAgentWorkspace
    ;;
  notify-agent|agent-notify)
    shift
    exec "$SCRIPT_DIR/omarchy-voice-agent-notify" "$@"
    ;;
  status)
    STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/voice/status.json"
    if [[ -f "$STATE_FILE" ]]; then
      cat "$STATE_FILE"
      echo ""
    else
      echo '{"state":"idle","title":"Idle","isMuted":false}'
    fi
    ;;
  help|--help|-h)
    cat << 'HELP_EOF'
omarchy-voice - Native Voice Assistant CLI & IPC Controller

Usage:
  omarchy-voice toggle       Toggle the compact floating voice pill
  omarchy-voice expand       Open the full drawer (transcript, parking lot, repos)
  omarchy-voice mute         Toggle microphone mute
  omarchy-voice dismiss      Dismiss/close active overlay surfaces
  omarchy-voice agent        Toggle the AI special workspace (special:agent)
  omarchy-voice notify-agent Audio chime + click-to-focus desktop notification
  omarchy-voice status       Display current state JSON (state, title, mute, repo)

Desktop Integrations:
  - Omarchy Status Bar: Click the voice orb widget on your bar
  - AI Scratchpad: Slides in automatically alongside special:agent
  - Keybindings: Configure your preferred keys in ~/.config/hypr/bindings.lua
HELP_EOF
    ;;
  *)
    echo "Unknown command: $action" >&2
    echo "Run 'omarchy-voice help' for usage." >&2
    exit 1
    ;;
esac
